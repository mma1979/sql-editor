@page "/sql-studio"
@using Mma.SqlStudio.SqlServer.Components
@using Mma.SqlStudio.SqlServer.Components.Layout
@inject Mma.SqlStudio.SqlServer.Services.SchemaService SchemaService
@inject Mma.SqlStudio.SqlServer.Services.EditorService EditorService
@inject IJSRuntime JSRuntime

<div class="page">
    <div class="top-bar">
        <div class="brand">
            <span class="logo"></span>
            <span class="app-name">SQL Studio Pro</span>
        </div>
        <div class="top-actions">
            <button class="primary" @onclick="ExecuteActiveQuery" disabled="@EditorService.IsExecuting">
                @if (EditorService.IsExecuting) { <span class="spinner-border spinner-border-sm mr-2"></span> }
                else { <i class="bi bi-play-fill"></i> }
                Run
            </button>
            <button class="secondary" @onclick="SaveActiveTab"><i class="bi bi-download"></i> Save</button>
        </div>
    </div>

    <main>
        <div class="workspace">
            <Sidebar />
            <div class="main-content">
                <div class="editor-section">
                    <SqlEditor />
                </div>
                <div class="results-section">
                    <ResultsGrid />
                </div>
            </div>
        </div>
    </main>

    <div class="status-bar">
        <div class="status-left">
            <span class="status-item"><i class="bi bi-database"></i> @currentConnection</span>
            <span class="status-item">MSSQL Server</span>
        </div>
        <div class="status-right">
            <span class="status-item">UTF-8</span>
            <span class="status-item">@((EditorService.LastResult?.Rows.Count ?? 0)) Rows</span>
            <span class="status-item">@(EditorService.IsExecuting ? "EXECUTING..." : "READY")</span>
        </div>
    </div>
</div>


@code {
    private string currentConnection = "Connected";

    protected override void OnInitialized()
    {
        EditorService.OnChange += StateHasChanged;
    }


    private async Task ExecuteActiveQuery()
    {
        var activeTab = EditorService.Tabs.FirstOrDefault(t => t.IsActive);
        if (activeTab == null || string.IsNullOrWhiteSpace(activeTab.Content)) return;

        EditorService.SetExecuting(true);
        var result = await SchemaService.ExecuteQueryAsync(activeTab.Content);
        EditorService.SetResult(result);
    }

    private async Task SaveActiveTab()
    {
        var activeTab = EditorService.Tabs.FirstOrDefault(t => t.IsActive);
        if (activeTab == null || string.IsNullOrWhiteSpace(activeTab.Content)) return;

        var filename = activeTab.Name;
        if (!filename.EndsWith(".sql", StringComparison.OrdinalIgnoreCase))
        {
            filename += ".sql";
        }

        await JSRuntime.InvokeVoidAsync("downloadFile", filename, activeTab.Content);
    }
}


<link rel="stylesheet" href="_content/Mma.SqlStudio.SqlServer/css/bootstrap-icons/bootstrap-icons.css" />
<script src="_content/Mma.SqlStudio.SqlServer/js/fileHelper.js"></script>
