@inherits LayoutComponentBase

<div class="page">
    <div class="top-bar">
        <div class="brand">
            <span class="logo"></span>
            <span class="app-name">SQL Studio Pro</span>
        </div>
        <div class="top-actions">
            <button class="primary" @onclick="ShowConnect"><i class="bi bi-plug-fill"></i> Connect</button>
            <button class="primary"><i class="bi bi-play-fill"></i> Run</button>
            <button class="secondary">Save</button>
            <div class="separator"></div>
            <i class="bi bi-download action-icon"></i>
            <i class="bi bi-clock-history action-icon"></i>
            <i class="bi bi-gear action-icon"></i>
        </div>
    </div>

    <main>
        @Body
    </main>

    <div class="status-bar">
        <div class="status-left">
            <span class="status-item"><i class="bi bi-database"></i> @currentConnection</span>
            <span class="status-item">PostgreSQL 15.4</span>
        </div>
        <div class="status-right">
            <span class="status-item">UTF-8</span>
            <span class="status-item">ROW: 1, COL: 1</span>
            <span class="status-item">LN 9, COL 24</span>
        </div>
    </div>
</div>

<ConnectionDialog @bind-Visible="isConnectVisible" OnConnected="HandleConnected" />

@code {
    private bool isConnectVisible = false;
    private string currentConnection = "Connected: db-prod-cluster-01";

    private void ShowConnect() => isConnectVisible = true;

    private void HandleConnected(string connectionString)
    {
        // For demonstration, we just update the status bar
        currentConnection = "Connected: " + (connectionString.Length > 20 ? connectionString.Substring(0, 20) + "..." : connectionString);
    }
}
