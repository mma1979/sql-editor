@using sql_editor.Services
@inject EditorService EditorService
@inject SchemaService SchemaService
@inject Microsoft.Extensions.Options.IOptions<sql_editor.Models.SqlStudioOptions> Config

<div class="sidebar">
    <div class="sidebar-header">
        <div class="active-db">
            <i class="bi bi-database-fill action-blue"></i>
            <span class="label-sm">@Config.Value.Direct.Database</span>
        </div>
        <div class="header-actions">
            <i class="bi bi-arrow-repeat @(isRefreshing ? "spin" : "")" @onclick="RefreshExplorer" title="Refresh"></i>
        </div>
    </div>

    <div class="sidebar-search">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" 
                   placeholder="Filter @Config.Value.Direct.Database..." 
                   @bind="filterText" 
                   @bind:event="oninput" 
                   @onkeyup="FilterTree" />
            @if (!string.IsNullOrEmpty(filterText))
            {
                <i class="bi bi-x-circle-fill clear-btn" @onclick="ClearFilter"></i>
            }
        </div>
    </div>
    
    <div class="sidebar-content">
        @if (isLoading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <span>Loading metadata...</span>
            </div>
        }
        else if (!schemas.Any())
        {
            <div class="empty-state">
                <i class="bi bi-exclamation-triangle"></i>
                <span>No connection or no objects found.</span>
            </div>
        }
        else
        {
            @foreach (var schema in schemas)
            {
                @if (schema.IsVisible)
                {
                    <div class="tree-item">
                        <div class="tree-row" @onclick="() => ToggleNode(schema)">
                            <i class="bi bi-caret-@(schema.IsExpanded ? "down" : "right")-fill caret"></i>
                            <i class="bi bi-shield-lock" style="color: #90A4AE"></i>
                            <span class="body-md">@schema.Name</span>
                        </div>
                        @if (schema.IsExpanded)
                        {
                            <div class="tree-children">
                                @foreach (var group in schema.Children)
                                {
                                    @if (group.IsVisible)
                                    {
                                        <div class="tree-item">
                                            <div class="tree-row" @onclick="() => ToggleNode(group)">
                                                <i class="bi bi-caret-@(group.IsExpanded ? "down" : "right")-fill caret"></i>
                                                <i class="bi @(group.Name == "Tables" ? "bi-folder-fill" : group.Name == "Views" ? "bi-layout-sidebar-inset" : "bi-cpu")" 
                                                   style="color: @(group.Name == "Tables" ? "#FFCA28" : group.Name == "Views" ? "#4CAF50" : "#9C27B0")"></i>
                                                <span class="body-md">@group.Name</span>
                                            </div>
                                            @if (group.IsExpanded)
                                            {
                                                <div class="tree-children">
                                                    @foreach (var obj in group.Children)
                                                    {
                                                        @if (obj.IsVisible)
                                                        {
                                                            <div class="tree-row obj-row" @ondblclick="() => OpenObjectScript(schema.Name, group.Name, obj.Name)">
                                                                <i class="bi @(group.Name == "Tables" ? "bi-table" : group.Name == "Views" ? "bi-grid-3x3-gap" : "bi-terminal") on-surface-variant"></i>
                                                                <span class="body-md">@obj.Name</span>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            }
        }
    </div>
</div>

@code {
    private string filterText = "";
    private List<Node> schemas = new();
    private bool isLoading = true;
    private bool isRefreshing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        var dbSchemas = await SchemaService.GetSchemaAsync();
        
        schemas = dbSchemas.Select(s => new Node(s.Name) {
            Children = s.Children.Select(c => new Node(c.Name) {
                Children = c.Objects.Select(o => new Node(o)).ToList()
            }).ToList()
        }).ToList();

        // Expand dbo and its Tables by default if they exist
        var dbo = schemas.FirstOrDefault(s => s.Name.Equals("dbo", StringComparison.OrdinalIgnoreCase));
        if (dbo != null) {
            dbo.IsExpanded = true;
            var tables = dbo.Children.FirstOrDefault(c => c.Name == "Tables");
            if (tables != null) tables.IsExpanded = true;
        }

        isLoading = false;
        StateHasChanged();
    }

    private void ToggleNode(Node node) => node.IsExpanded = !node.IsExpanded;

    private void OpenObjectScript(string schema, string group, string name)
    {
        string tabName = $"{schema}.{name}.sql";
        string content = $"-- Script for {group.TrimEnd('s')} {schema}.{name}\n";
        
        if (group == "Tables")
            content += $"SELECT TOP 100 * FROM [{schema}].[{name}];";
        else if (group == "Views")
            content += $"SELECT TOP 100 * FROM [{schema}].[{name}];";
        else
            content += $"EXEC [{schema}].[{name}];";

        EditorService.AddTab(tabName, content);
    }

    private void FilterTree()
    {
        if (string.IsNullOrWhiteSpace(filterText))
        {
            SetVisibility(schemas, true);
            return;
        }
        FilterRecursive(schemas, filterText.ToLower());
    }

    private bool FilterRecursive(List<Node> nodes, string filter)
    {
        bool anyChildVisible = false;
        foreach (var node in nodes)
        {
            bool matches = node.Name.ToLower().Contains(filter);
            bool childMatches = FilterRecursive(node.Children, filter);
            node.IsVisible = matches || childMatches;
            if (node.IsVisible) anyChildVisible = true;
            if (childMatches && !string.IsNullOrWhiteSpace(filter)) node.IsExpanded = true;
        }
        return anyChildVisible;
    }

    private void SetVisibility(List<Node> nodes, bool visible)
    {
        foreach (var node in nodes)
        {
            node.IsVisible = visible;
            SetVisibility(node.Children, visible);
        }
    }

    private void ClearFilter()
    {
        filterText = "";
        FilterTree();
    }

    private async Task RefreshExplorer()
    {
        isRefreshing = true;
        await LoadData();
        isRefreshing = false;
        FilterTree();
    }

    public class Node
    {
        public string Name { get; set; }
        public bool IsExpanded { get; set; }
        public bool IsVisible { get; set; } = true;
        public List<Node> Children { get; set; } = new();
        public Node(string name, bool expanded = false) { Name = name; IsExpanded = expanded; }
    }
}

<style>
    .sidebar {
        width: 260px;
        background-color: var(--surface-container-low);
        border-right: 1px solid var(--outline-variant);
        display: flex;
        flex-direction: column;
        height: 100%;
        flex-shrink: 0;
    }

    .sidebar-header {
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 12px;
        border-bottom: 1px solid var(--outline-variant);
    }

    .active-db {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--on-surface);
    }

    .sidebar-search {
        padding: 8px 12px;
        border-bottom: 1px solid var(--outline-variant);
        background-color: var(--surface-container-lowest);
    }

    .search-box {
        display: flex;
        align-items: center;
        background-color: var(--surface-container-low);
        border: 1px solid var(--outline-variant);
        border-radius: 4px;
        padding: 2px 8px;
        gap: 8px;
    }

    .search-box input {
        width: 100%;
        background: transparent;
        border: none;
        outline: none;
        color: var(--on-surface);
        font-size: 12px;
        padding: 4px 0;
    }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        padding: 8px 0;
    }

    .loading-state, .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100px;
        gap: 12px;
        color: var(--on-surface-variant);
        font-size: 12px;
    }

    .spinner {
        width: 20px;
        height: 20px;
        border: 2px solid var(--outline-variant);
        border-top: 2px solid var(--primary);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    .spin { animation: spin 1s linear infinite; }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .tree-row {
        height: 28px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 12px;
        cursor: pointer;
        user-select: none;
    }

    .tree-row:hover { background-color: var(--surface-container-high); }
    .tree-children { padding-left: 12px; }
    .caret { font-size: 10px; width: 12px; color: var(--on-surface-variant); }
    .obj-row { padding-left: 12px; }
    .header-actions i { cursor: pointer; color: var(--on-surface-variant); }
</style>
