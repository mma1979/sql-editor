@using sql_editor.Services
@inject EditorService EditorService

<div class="sidebar">
    <div class="sidebar-header">
        <div class="active-db">
            <i class="bi bi-database-fill action-blue"></i>
            <span class="label-sm">PRODUCTION_DB</span>
        </div>
        <div class="header-actions">
            <i class="bi bi-arrow-repeat" @onclick="RefreshExplorer" title="Refresh"></i>
        </div>
    </div>

    <div class="sidebar-search">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" 
                   placeholder="Filter production_db..." 
                   @bind="filterText" 
                   @bind:event="oninput" 
                   @onkeyup="FilterTree" />
            @if (!string.IsNullOrEmpty(filterText))
            {
                <i class="bi bi-x-circle-fill clear-btn" @onclick="ClearFilter"></i>
            }
        </div>
    </div>
    
    <div class="sidebar-content">
        @foreach (var schema in schemas)
        {
            @if (schema.IsVisible)
            {
                <div class="tree-item">
                    <div class="tree-row" @onclick="() => ToggleNode(schema)">
                        <i class="bi bi-caret-@(schema.IsExpanded ? "down" : "right")-fill caret"></i>
                        <i class="bi bi-shield-lock" style="color: #90A4AE"></i>
                        <span class="body-md">@schema.Name</span>
                    </div>
                    @if (schema.IsExpanded)
                    {
                        <div class="tree-children">
                            @foreach (var group in schema.Children)
                            {
                                @if (group.IsVisible)
                                {
                                    <div class="tree-item">
                                        <div class="tree-row" @onclick="() => ToggleNode(group)">
                                            <i class="bi bi-caret-@(group.IsExpanded ? "down" : "right")-fill caret"></i>
                                            <i class="bi @(group.Name == "Tables" ? "bi-folder-fill" : group.Name == "Views" ? "bi-layout-sidebar-inset" : "bi-cpu")" 
                                               style="color: @(group.Name == "Tables" ? "#FFCA28" : group.Name == "Views" ? "#4CAF50" : "#9C27B0")"></i>
                                            <span class="body-md">@group.Name</span>
                                        </div>
                                        @if (group.IsExpanded)
                                        {
                                            <div class="tree-children">
                                                @foreach (var obj in group.Children)
                                                {
                                                    @if (obj.IsVisible)
                                                    {
                                                        <div class="tree-row obj-row" @ondblclick="() => OpenObjectScript(schema.Name, group.Name, obj.Name)">
                                                            <i class="bi @(group.Name == "Tables" ? "bi-table" : group.Name == "Views" ? "bi-grid-3x3-gap" : "bi-terminal") on-surface-variant"></i>
                                                            <span class="body-md">@obj.Name</span>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
    
    <div class="sidebar-footer">
        <div class="tree-row"><i class="bi bi-clock-history"></i><span>History</span></div>
        <div class="tree-row"><i class="bi bi-star"></i><span>Favorites</span></div>
        <div class="tree-row"><i class="bi bi-gear"></i><span>Settings</span></div>
    </div>
</div>

@code {
    private string filterText = "";
    private List<Node> schemas = new();

    protected override void OnInitialized()
    {
        InitializeData();
    }

    private void InitializeData()
    {
        schemas = new List<Node>
        {
            new Node("dbo") {
                IsExpanded = true,
                Children = new List<Node> {
                    new Node("Tables") {
                        IsExpanded = true,
                        Children = new List<Node> {
                            new Node("analytics_events"),
                            new Node("user_metadata"),
                            new Node("transaction_logs")
                        }
                    },
                    new Node("Views") {
                        Children = new List<Node> {
                            new Node("active_users_view")
                        }
                    }
                }
            },
            new Node("sales") {
                Children = new List<Node> {
                    new Node("Tables") {
                        Children = new List<Node> {
                            new Node("orders"),
                            new Node("customers"),
                            new Node("invoices")
                        }
                    }
                }
            },
            new Node("analytics") {
                Children = new List<Node> {
                    new Node("Views") {
                        Children = new List<Node> {
                            new Node("daily_revenue_report"),
                            new Node("user_retention_cohorts")
                        }
                    }
                }
            }
        };
    }

    private void ToggleNode(Node node) => node.IsExpanded = !node.IsExpanded;

    private void OpenObjectScript(string schema, string group, string name)
    {
        string tabName = $"{schema}.{name}.sql";
        string content = $"-- Script for {group.TrimEnd('s')} {schema}.{name}\n";
        
        if (group == "Tables")
        {
            content += $"CREATE TABLE [{schema}].[{name}] (\n    [Id] INT PRIMARY KEY IDENTITY(1,1),\n    [CreatedAt] DATETIME2 DEFAULT GETDATE(),\n    [Payload] NVARCHAR(MAX)\n);";
        }
        else if (group == "Views")
        {
            content += $"CREATE VIEW [{schema}].[{name}] AS\nSELECT * FROM [{schema}].[some_base_table]\nWHERE [IsActive] = 1;";
        }
        else
        {
            content += $"CREATE PROCEDURE [{schema}].[{name}]\nAS\nBEGIN\n    SET NOCOUNT ON;\n    SELECT 'Executing {name}...';\nEND;";
        }

        EditorService.AddTab(tabName, content);
    }

    private void FilterTree()
    {
        if (string.IsNullOrWhiteSpace(filterText))
        {
            SetVisibility(schemas, true);
            return;
        }

        FilterRecursive(schemas, filterText.ToLower());
    }

    private bool FilterRecursive(List<Node> nodes, string filter)
    {
        bool anyChildVisible = false;
        foreach (var node in nodes)
        {
            bool matches = node.Name.ToLower().Contains(filter);
            bool childMatches = FilterRecursive(node.Children, filter);
            
            node.IsVisible = matches || childMatches;
            if (node.IsVisible) anyChildVisible = true;
            
            if (childMatches && !string.IsNullOrWhiteSpace(filter)) node.IsExpanded = true;
        }
        return anyChildVisible;
    }

    private void SetVisibility(List<Node> nodes, bool visible)
    {
        foreach (var node in nodes)
        {
            node.IsVisible = visible;
            SetVisibility(node.Children, visible);
        }
    }

    private void ClearFilter()
    {
        filterText = "";
        FilterTree();
    }

    private void RefreshExplorer()
    {
        InitializeData();
        FilterTree();
    }

    public class Node
    {
        public string Name { get; set; }
        public bool IsExpanded { get; set; }
        public bool IsVisible { get; set; } = true;
        public List<Node> Children { get; set; } = new();

        public Node(string name, bool expanded = false)
        {
            Name = name;
            IsExpanded = expanded;
        }
    }
}

<style>
    .sidebar {
        width: 260px;
        background-color: var(--surface-container-low);
        border-right: 1px solid var(--outline-variant);
        display: flex;
        flex-direction: column;
        height: 100%;
        flex-shrink: 0;
    }

    .sidebar-header {
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 12px;
        border-bottom: 1px solid var(--outline-variant);
        background-color: var(--surface-container-low);
    }

    .active-db {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--on-surface);
    }

    .sidebar-search {
        padding: 8px 12px;
        border-bottom: 1px solid var(--outline-variant);
        background-color: var(--surface-container-lowest);
    }

    .search-box {
        position: relative;
        display: flex;
        align-items: center;
        background-color: var(--surface-container-low);
        border: 1px solid var(--outline-variant);
        border-radius: 4px;
        padding: 2px 8px;
        gap: 8px;
    }

    .search-box i {
        font-size: 12px;
        color: var(--on-surface-variant);
    }

    .search-box input {
        width: 100%;
        background: transparent;
        border: none;
        outline: none;
        color: var(--on-surface);
        font-size: 12px;
        padding: 4px 0;
    }

    .clear-btn {
        cursor: pointer;
        opacity: 0.7;
    }

    .clear-btn:hover {
        opacity: 1;
    }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        padding: 8px 0;
    }

    .tree-row {
        height: 28px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 12px;
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .tree-row:hover {
        background-color: var(--surface-container-high);
    }

    .tree-children {
        padding-left: 12px;
    }

    .caret {
        font-size: 10px;
        width: 12px;
        color: var(--on-surface-variant);
    }

    .obj-row {
        padding-left: 12px;
    }

    .header-actions i {
        cursor: pointer;
        font-size: 14px;
        color: var(--on-surface-variant);
    }

    .sidebar-footer {
        border-top: 1px solid var(--outline-variant);
        padding: 4px 0;
        background-color: var(--surface-container-lowest);
        font-size: 12px;
        color: var(--on-surface-variant);
    }
</style>
