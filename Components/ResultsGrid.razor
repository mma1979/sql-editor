@using sql_editor.Services
@inject EditorService EditorService
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="results-container">
    <div class="results-header">
        <div class="header-left">
            <span class="label-sm">RESULTS</span>
            @if (EditorService.LastResult != null)
            {
                <span class="badge @(EditorService.LastResult.Success ? "success" : "error")">
                    @(EditorService.LastResult.Success ? "Success" : "Error")
                </span>
                <span class="message-sm">@EditorService.LastResult.Message</span>
            }
        </div>
        <div class="header-right">
            @if (EditorService.LastResult != null && EditorService.LastResult.Success && EditorService.LastResult.IsQuery && EditorService.LastResult.Rows.Any())
            {
                <button class="ghost-sm" @onclick="ExportToCsv"><i class="bi bi-download"></i> Export CSV</button>
            }
        </div>
    </div>
    
    <div class="grid-wrapper">
        @if (EditorService.IsExecuting)
        {
            <div class="grid-overlay">
                <div class="spinner"></div>
                <span>Executing command...</span>
            </div>
        }
        
        @if (EditorService.LastResult != null && EditorService.LastResult.Success)
        {
            @if (EditorService.LastResult.IsQuery)
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="row-no">#</th>
                            @foreach (var col in EditorService.LastResult.Columns)
                            {
                                <th>@col</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < EditorService.LastResult.Rows.Count; i++)
                        {
                            var row = EditorService.LastResult.Rows[i];
                            <tr>
                                <td class="row-no">@(i + 1)</td>
                                @foreach (var cell in row)
                                {
                                    <td>@cell</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="non-query-success">
                    <i class="bi bi-check-circle-fill"></i>
                    <div class="details">
                        <span class="headline-sm">Command completed successfully</span>
                        <span class="body-md">@EditorService.LastResult.Message</span>
                    </div>
                </div>
            }
        }
        else if (EditorService.LastResult != null && !EditorService.LastResult.Success)
        {
            <div class="error-panel">
                <i class="bi bi-x-circle"></i>
                <pre>@EditorService.LastResult.Message</pre>
            </div>
        }
        else if (!EditorService.IsExecuting)
        {
            <div class="empty-results">
                <i class="bi bi-table"></i>
                <span>No results to display. Run a query or command to see feedback.</span>
            </div>
        }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        EditorService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        EditorService.OnChange -= StateHasChanged;
    }

    private async Task ExportToCsv()
    {
        if (EditorService.LastResult == null || !EditorService.LastResult.IsQuery) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(",", EditorService.LastResult.Columns.Select(c => $"\"{c.Replace("\"", "\"\"")}\"")));

        foreach (var row in EditorService.LastResult.Rows)
        {
            sb.AppendLine(string.Join(",", row.Select(r => $"\"{r.Replace("\"", "\"\"")}\"")));
        }

        var fileName = $"query_export_{DateTime.Now:yyyyMMddHHmmss}.csv";
        
        await JSRuntime.InvokeVoidAsync("eval", @"
            window.downloadFile = (fileName, content) => {
                const blob = new Blob([content], { type: 'text/csv' });
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
            };
        ");
        
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, sb.ToString());
    }
}

<style>
    .results-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        background-color: var(--surface);
    }

    .results-header {
        height: 36px;
        background-color: var(--surface-container-low);
        border-bottom: 1px solid var(--outline-variant);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 12px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .grid-wrapper {
        flex: 1;
        overflow: auto;
        position: relative;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-mono);
        font-size: 12px;
    }

    .data-table thead th {
        position: sticky;
        top: 0;
        background-color: var(--surface-container-high);
        color: var(--on-surface-variant);
        text-align: left;
        padding: 8px 12px;
        border-right: 1px solid var(--outline-variant);
        border-bottom: 2px solid var(--outline-variant);
        white-space: nowrap;
        z-index: 10;
    }

    .data-table tbody td {
        padding: 6px 12px;
        border-right: 1px solid var(--outline-variant);
        border-bottom: 1px solid var(--outline-variant);
        color: var(--on-surface);
        white-space: nowrap;
    }

    .data-table tr:hover {
        background-color: var(--surface-container-low);
    }

    .row-no {
        width: 40px;
        text-align: center !important;
        background-color: var(--surface-container-lowest);
        color: var(--outline);
    }

    .non-query-success {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        color: #81C784;
    }

    .non-query-success i { font-size: 48px; }

    .non-query-success .details {
        display: flex;
        flex-direction: column;
        gap: 4px;
        color: var(--on-surface);
    }

    .badge {
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .badge.success { background-color: rgba(76, 175, 80, 0.2); color: #81C784; }
    .badge.error { background-color: rgba(244, 67, 54, 0.2); color: #E57373; }

    .message-sm { font-size: 12px; color: var(--on-surface-variant); }

    .error-panel {
        padding: 24px;
        color: #E57373;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .error-panel pre {
        white-space: pre-wrap;
        font-family: var(--font-mono);
        font-size: 13px;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.4);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        z-index: 20;
        backdrop-filter: blur(2px);
    }

    .empty-results {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        color: var(--outline);
    }

    .ghost-sm {
        background: transparent;
        border: none;
        color: var(--primary);
        font-size: 12px;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 4px;
    }

    .ghost-sm:hover { background: rgba(var(--primary-rgb), 0.1); }

    .spinner {
        width: 32px;
        height: 32px;
        border: 4px solid var(--outline-variant);
        border-top: 4px solid var(--primary);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>
