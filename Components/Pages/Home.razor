@page "/"
@using sql_editor.Components
@using sql_editor.Components.Layout

<div class="workspace">
    <Sidebar />
    <div class="main-content">
        <div class="editor-section">
            <SqlEditor />
        </div>
        <div class="results-section">
            <ResultsGrid />
        </div>
    </div>
</div>

<style>
    .workspace {
        display: flex;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .editor-section {
        flex: 3; /* Give more space to editor */
        min-height: 200px;
        overflow: hidden;
    }

    .results-section {
        flex: 2;
        min-height: 150px;
        overflow: hidden;
    }
</style>
