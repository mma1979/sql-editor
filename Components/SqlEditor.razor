@inject IJSRuntime JSRuntime

<div class="editor-container">
    <div class="tabs">
        @foreach (var tab in tabs)
        {
            <div class="tab @(tab.IsActive ? "active" : "")" @onclick="() => SelectTab(tab)">
                <i class="bi @(tab.Name.EndsWith(".sql") ? "bi-filetype-sql" : "bi-table")"></i>
                <span>@tab.Name</span>
                <i class="bi bi-x close-btn" @onclick:stopPropagation="true" @onclick="() => CloseTab(tab)"></i>
            </div>
        }
        <div class="add-tab" @onclick="AddTab">
            <i class="bi bi-plus"></i>
        </div>
    </div>
    
    <div class="editor-pane">
        @if (ActiveTab != null)
        {
            <div class="line-numbers" id="line-numbers">
                @for (int i = 1; i <= Math.Max(1, ActiveTab.Content.Split('\n').Length); i++)
                {
                    <div class="line-no">@i</div>
                }
            </div>
            <div class="code-area-wrapper">
                <div class="highlight-layer code-md" id="highlight-layer">@GetHighlightedContent()</div>
                <textarea @key="ActiveTab.Name"
                          id="code-editor"
                          class="code-editor code-md" 
                          spellcheck="false" 
                          @bind="ActiveTab.Content"
                          @bind:event="oninput"
                          @onscroll="OnEditorScroll"
                          @ref="editorRef"></textarea>
            </div>
            
            <div class="editor-actions">
                <button class="secondary" @onclick="FormatSql"><i class="bi bi-text-left"></i> Format</button>
                <button class="secondary" @onclick="CopySql"><i class="bi bi-copy"></i> @(isCopied ? "Copied!" : "Copy")</button>
            </div>
        }
        else
        {
            <div class="empty-editor">
                <i class="bi bi-file-earmark-code" style="font-size: 48px; color: var(--outline-variant)"></i>
                <span class="body-md on-surface-variant">No files open. Create a new query to begin.</span>
            </div>
        }
    </div>
</div>

@code {
    private List<EditorTab> tabs = new()
    {
        new("query_1.sql", true, "SELECT\n    u.id,\n    u.username,\n    COUNT(e.id) AS total_events,\n    MAX(e.timestamp) AS last_active\nFROM users u\nJOIN events e ON u.id = e.user_id\nWHERE e.status = 'active'\nGROUP BY u.id, u.username\nORDER BY last_active DESC;"),
        new("analysis_view.sql", false, "-- Write your analysis query here\nSELECT * FROM user_metadata;")
    };

    private bool isCopied = false;
    private ElementReference editorRef;

    private EditorTab? ActiveTab => tabs.FirstOrDefault(t => t.IsActive);

    private void SelectTab(EditorTab tab)
    {
        tabs.ForEach(t => t.IsActive = false);
        tab.IsActive = true;
        isCopied = false;
    }

    private void CloseTab(EditorTab tab)
    {
        tabs.Remove(tab);
        if (tab.IsActive && tabs.Any())
        {
            tabs.Last().IsActive = true;
        }
        isCopied = false;
    }

    private void AddTab()
    {
        tabs.ForEach(t => t.IsActive = false);
        tabs.Add(new EditorTab($"query_{tabs.Count + 1}.sql", true, "-- New Query"));
        isCopied = false;
    }

    private async Task CopySql()
    {
        if (ActiveTab != null)
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", ActiveTab.Content);
            isCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            isCopied = false;
            StateHasChanged();
        }
    }

    private void FormatSql()
    {
        if (ActiveTab != null)
        {
            string[] keywords = { "SELECT", "FROM", "WHERE", "JOIN", "ON", "GROUP BY", "ORDER BY", "DESC", "ASC", "AND", "OR", "IN", "AS", "LIMIT", "COUNT", "MAX", "MIN", "AVG", "SUM", "UPDATE", "SET", "DELETE", "INSERT", "INTO", "VALUES", "CREATE", "TABLE", "DATABASE", "DROP", "ALTER", "EXISTS", "NOT", "NULL", "PRIMARY", "KEY", "FOREIGN", "REFERENCES" };
            string content = ActiveTab.Content;
            
            foreach (var keyword in keywords)
            {
                content = System.Text.RegularExpressions.Regex.Replace(
                    content, 
                    @"\b" + keyword + @"\b", 
                    keyword, 
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            }
            
            ActiveTab.Content = content;
        }
    }

    private async Task OnEditorScroll(EventArgs e)
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            var editor = document.getElementById('code-editor');
            var layer = document.getElementById('highlight-layer');
            var gutter = document.getElementById('line-numbers');
            if (editor && layer) {
                layer.scrollTop = editor.scrollTop;
                layer.scrollLeft = editor.scrollLeft;
            }
            if (editor && gutter) {
                gutter.scrollTop = editor.scrollTop;
            }
        ");
    }

    private MarkupString GetHighlightedContent()
    {
        if (ActiveTab == null) return new MarkupString("");

        string code = System.Net.WebUtility.HtmlEncode(ActiveTab.Content);

        // Single-pass regex to avoid matching inside previously added tags
        // Pattern matches comments, strings, or keywords/functions
        string pattern = @"(?<comment>--.*)|(?<string>'.*?')|(?<keyword>\b(SELECT|FROM|WHERE|JOIN|ON|GROUP\s+BY|ORDER\s+BY|DESC|ASC|AND|OR|IN|AS|LIMIT|UPDATE|SET|DELETE|INSERT|INTO|VALUES|CREATE|TABLE|DATABASE|DROP|ALTER|EXISTS|NOT|NULL|PRIMARY|KEY|FOREIGN|REFERENCES|GO|USE|EXEC|PROCEDURE)\b)|(?<function>\b(COUNT|MAX|MIN|AVG|SUM|GETDATE|CAST|CONVERT|COALESCE)\b)";
        
        string result = System.Text.RegularExpressions.Regex.Replace(code, pattern, m => {
            if (m.Groups["comment"].Success) return $"<span class='hl-comment'>{m.Value}</span>";
            if (m.Groups["string"].Success) return $"<span class='hl-string'>{m.Value}</span>";
            if (m.Groups["keyword"].Success) return $"<span class='hl-keyword'>{m.Value}</span>";
            if (m.Groups["function"].Success) return $"<span class='hl-function'>{m.Value}</span>";
            return m.Value;
        }, System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        // Add a space if ends with newline to ensure scrolling/height parity
        if (result.EndsWith("\n")) result += " ";

        return new MarkupString(result);
    }

    public class EditorTab
    {
        public string Name { get; set; }
        public bool IsActive { get; set; }
        public string Content { get; set; }
        public EditorTab(string name, bool isActive, string content = "") 
        {
            Name = name;
            IsActive = isActive;
            Content = content;
        }
    }
}

<style>
    .editor-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
        background-color: var(--surface);
    }

    .tabs {
        height: 36px;
        background-color: var(--surface-container-lowest);
        display: flex;
        align-items: flex-end;
        border-bottom: 1px solid var(--outline-variant);
        overflow-x: auto;
    }

    .tab {
        height: 32px;
        padding: 0 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        background-color: var(--surface-container-low);
        border: 1px solid var(--outline-variant);
        border-bottom: none;
        border-radius: 4px 4px 0 0;
        margin-right: 2px;
        cursor: pointer;
        font-size: 13px;
        color: var(--on-surface-variant);
        white-space: nowrap;
    }

    .tab.active {
        background-color: var(--surface);
        color: var(--on-surface);
        border-bottom: 2px solid var(--primary-container);
        height: 33px;
    }

    .editor-pane {
        flex: 1;
        display: flex;
        position: relative;
        overflow: hidden;
    }

    .line-numbers {
        width: 40px;
        background-color: var(--surface-container-lowest);
        border-right: 1px solid var(--outline-variant);
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        padding: 16px 8px;
        color: var(--outline);
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 20px;
        user-select: none;
        overflow: hidden; /* Scrolled by JS */
    }

    .code-area-wrapper {
        flex: 1;
        position: relative;
        overflow: hidden;
        background-color: var(--surface);
    }

    .highlight-layer, .code-editor {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        padding: 16px;
        border: none;
        outline: none;
        background: transparent;
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 20px;
        white-space: pre;
        margin: 0;
        box-sizing: border-box;
        overflow: auto;
        tab-size: 4;
    }

    .highlight-layer {
        z-index: 1;
        pointer-events: none;
        color: var(--on-surface);
        overflow: hidden; /* Scrolled by JS */
    }

    .code-editor {
        z-index: 2;
        color: transparent;
        caret-color: var(--on-surface);
    }

    /* Highlight Colors - MSSQL Style */
    .hl-keyword { color: #569CD6; font-weight: 600; }
    .hl-string { color: #800000; }
    .hl-comment { color: #6A9955; }
    .hl-function { color: #C586C0; }

    .editor-actions {
        position: absolute;
        top: 12px;
        right: 12px;
        display: flex;
        gap: 8px;
        z-index: 10;
    }

    .empty-editor {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
    }
</style>
