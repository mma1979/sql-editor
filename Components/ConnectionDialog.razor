@using Mma.SqlStudio.SqlServer.Models
@using Microsoft.Extensions.Options
@inject IOptions<SqlStudioOptions> Config

<div class="modal-backdrop @(Visible ? "visible" : "")">
    <div class="modal-container">
        <div class="modal-header">
            <span class="label-md">CONNECT TO DATA SOURCE</span>
            <i class="bi bi-x-lg close-icon" @onclick="Close"></i>
        </div>
        
        <div class="modal-tabs">
            <div class="modal-tab @(mode == "builder" ? "active" : "")" @onclick='() => mode = "builder"'>Direct Builder</div>
            <div class="modal-tab @(mode == "string" ? "active" : "")" @onclick='() => mode = "string"'>Connection String</div>
            <div class="modal-tab @(mode == "api" ? "active" : "")" @onclick='() => mode = "api"'>API Proxy</div>
        </div>

        <div class="modal-content">
            @if (mode == "builder")
            {
                <div class="form-group">
                    <label>Server Name</label>
                    <input type="text" placeholder="e.g. localhost, 127.0.0.1" @bind="server" />
                </div>
                <div class="form-row">
                    <div class="form-group flex-1">
                        <label>Authentication</label>
                        <select @bind="authMode">
                            <option value="windows">Windows Authentication</option>
                            <option value="sql">SQL Server Authentication</option>
                        </select>
                    </div>
                </div>
                @if (authMode == "sql")
                {
                    <div class="form-row">
                        <div class="form-group flex-1">
                            <label>Username</label>
                            <input type="text" @bind="username" />
                        </div>
                        <div class="form-group flex-1">
                            <label>Password</label>
                            <input type="password" @bind="password" />
                        </div>
                    </div>
                }
                <div class="form-group">
                    <label>Database</label>
                    <div class="input-with-action">
                        <input type="text" placeholder="Database name" @bind="database" />
                    </div>
                </div>
            }
            else if (mode == "string")
            {
                <div class="form-group">
                    <label>Connection String</label>
                    <textarea class="raw-string" placeholder="Server=myServerAddress;Database=myDataBase;..." @bind="connectionString"></textarea>
                </div>
            }
            else if (mode == "api")
            {
                <div class="form-group">
                    <label>API Endpoint URL</label>
                    <input type="text" placeholder="https://api.yourdomain.com/sql-proxy" @bind="apiUrl" />
                </div>
                <div class="form-group">
                    <label>Authentication Token</label>
                    <input type="password" placeholder="Bearer Token or API Key" @bind="apiToken" />
                </div>
                <div class="form-group">
                    <label>Target Database Identifier</label>
                    <input type="text" placeholder="e.g. prod-db-01" @bind="apiDbId" />
                </div>
            }

            @if (mode != "api")
            {
                <div class="options-grid">
                    <div class="checkbox-item">
                        <input type="checkbox" id="trust" @bind="trustServer" />
                        <label for="trust">Trust Server Certificate</label>
                    </div>
                    <div class="checkbox-item">
                        <input type="checkbox" id="encrypt" @bind="encrypt" />
                        <label for="encrypt">Encrypt Connection</label>
                    </div>
                </div>
            }
        </div>

        <div class="modal-footer">
            <button class="secondary" @onclick="Close">Cancel</button>
            <button class="primary" @onclick="Connect">Connect</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<string> OnConnected { get; set; }

    private string mode = "builder";
    private string server = "";
    private string authMode = "windows";
    private string username = "";
    private string password = "";
    private string database = "";
    private string connectionString = "";
    private bool trustServer = true;
    private bool encrypt = false;

    private string apiUrl = "";
    private string apiToken = "";
    private string apiDbId = "";

    protected override void OnInitialized()
    {
        var settings = Config.Value;
        mode = settings.ConnectionMode;
        
        // Load Direct settings
        server = settings.Direct.Server;
        database = settings.Direct.Database;
        authMode = settings.Direct.AuthMode;
        username = settings.Direct.Username;
        password = settings.Direct.Password;

        // Load string settings
        connectionString = settings.ConnectionString;

        // Load API settings
        apiUrl = settings.ApiProxy.Url;
        apiToken = settings.ApiProxy.Token;
        apiDbId = settings.ApiProxy.DatabaseId;
    }

    private async Task Close() => await VisibleChanged.InvokeAsync(false);

    private async Task Connect()
    {
        string finalString = "";
        if (mode == "api")
        {
            finalString = $"API:{apiUrl}|DB:{apiDbId}";
        }
        else if (mode == "string")
        {
            finalString = connectionString;
        }
        else
        {
            finalString = $"Server={server};Database={database};User Id={username};Password={password};";
        }
        
        await OnConnected.InvokeAsync(finalString);
        await Close();
    }
}

<style>
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-backdrop.visible {
        display: flex;
    }

    .modal-container {
        width: 520px;
        background-color: var(--surface-container-low);
        border: 1px solid var(--outline-variant);
        border-radius: 8px;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
        display: flex;
        flex-direction: column;
    }

    .modal-header {
        height: 48px;
        padding: 0 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--outline-variant);
    }

    .close-icon {
        cursor: pointer;
        color: var(--on-surface-variant);
    }

    .modal-tabs {
        display: flex;
        padding: 0 16px;
        border-bottom: 1px solid var(--outline-variant);
        gap: 20px;
    }

    .modal-tab {
        padding: 12px 0;
        font-size: 13px;
        font-weight: 500;
        color: var(--on-surface-variant);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        white-space: nowrap;
    }

    .modal-tab.active {
        color: var(--primary);
        border-bottom-color: var(--primary);
    }

    .modal-content {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-group label {
        font-size: 11px;
        font-weight: 600;
        color: var(--on-surface-variant);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-row {
        display: flex;
        gap: 16px;
    }

    .flex-1 { flex: 1; }

    input, select, textarea {
        background-color: var(--surface-container-lowest);
        border: 1px solid var(--outline-variant);
        border-radius: 4px;
        padding: 8px 12px;
        color: var(--on-surface);
        font-size: 13px;
        outline: none;
        transition: border-color 0.2s;
    }

    input:focus, select:focus, textarea:focus {
        border-color: var(--primary);
    }

    .raw-string {
        height: 100px;
        resize: none;
        font-family: var(--font-mono);
    }

    .input-with-action {
        display: flex;
        gap: 8px;
    }

    .input-with-action input { flex: 1; }

    .options-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 8px;
    }

    .checkbox-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: var(--on-surface-variant);
    }

    .modal-footer {
        padding: 16px 24px;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        background-color: var(--surface-container-lowest);
        border-top: 1px solid var(--outline-variant);
        border-radius: 0 0 8px 8px;
    }
</style>
